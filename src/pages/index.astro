---
import Layout from '../layouts/Layout.astro';
import FeaturedWork from '../components/FeaturedWork.astro';
import ContactSection from '../components/ContactSection.astro';
---

<Layout>
  <!-- Hero: bright open water at midday. The cciv 3D scene takes this slot when ready. -->
  <section class="relative min-h-dvh flex flex-col overflow-hidden" style="background: linear-gradient(180deg, var(--sky-top) 0%, var(--sky-bottom) 76%);">
    <div class="absolute inset-x-0 bottom-0 h-[24vh] bg-sea"></div>
    <div class="absolute inset-x-0 bottom-[24vh] h-px bg-white/70"></div>
    <img
      src="/sailboat.svg"
      alt="Sailing ship on the horizon"
      class="absolute left-1/2 -translate-x-1/2 bottom-[calc(24vh-52px)] w-36 text-ink/70"
      width="144"
      height="144"
    />

    <div class="relative z-10 flex-1 flex items-center justify-center pointer-events-none">
      <div class="pointer-events-auto text-center text-ink px-6 max-w-3xl -mt-[6vh]">
        <p class="font-mono text-xs tracking-[3px] uppercase opacity-50 mb-6">Patrick</p>
        <h1 class="font-display text-[clamp(2rem,5.5vw,3.75rem)] font-semibold tracking-[-1.5px] leading-[1.1] mb-5 text-balance">Turning ideas into innovative solutions</h1>
        <p class="text-[clamp(0.9rem,1.5vw,1.1rem)] text-ink-dim max-w-2xl mx-auto mb-8 font-light leading-relaxed">Software engineer navigating code, open source, and the space between them.</p>
        <div class="flex gap-4 justify-center flex-wrap">
          <a href="/projects" class="font-mono text-xs text-white no-underline px-5 py-2 rounded-[100px] bg-accent transition-all duration-300 hover:bg-accent-hover hover:-translate-y-pill">View projects</a>
          <a href="https://github.com/patrick204nqh" class="font-mono text-xs text-ink no-underline px-5 py-2 rounded-[100px] border border-white/60 bg-white/50 transition-all duration-300 hover:bg-white hover:-translate-y-pill">GitHub</a>
          <a href="https://linkedin.com/in/patrick204nqh" class="font-mono text-xs text-ink no-underline px-5 py-2 rounded-[100px] border border-white/60 bg-white/50 transition-all duration-300 hover:bg-white hover:-translate-y-pill">LinkedIn</a>
          <a href="mailto:patrick204nqh@gmail.com" class="font-mono text-xs text-ink no-underline px-5 py-2 rounded-[100px] border border-white/60 bg-white/50 transition-all duration-300 hover:bg-white hover:-translate-y-pill">Email</a>
        </div>
      </div>
    </div>
  </section>

  <section class="page-section relative z-10 py-24 bg-surface border-t border-border" id="about">
    <div class="max-w-[42rem] mx-auto px-6">
      <h2 class="font-display text-[clamp(1.5rem,3vw,2.25rem)] font-semibold tracking-[-0.75px] leading-[1.2] mb-6 max-w-[28ch] reveal">Every line of code is a step forward.</h2>
      <div class="text-ink-dim leading-relaxed max-w-[60ch] text-sm reveal reveal-delay-1">
        <p class="mb-4">I'm Patrick, a software engineer in Sai Gon. I build Ruby tooling for AI agents and the people who maintain software — durable, boring infrastructure over clever tricks. I contribute to open source, write about what I learn, and believe the best solutions come from curiosity, not certainty.</p>
        <p>I grew up in Bao Loc, Vietnam's fog city — tea country, highland coffee, misty mornings. The course from the highlands to the open water runs through everything on this site.</p>
      </div>
      <div class="flex flex-col mt-10">
        {[
          { title: 'Craft over hype', desc: 'Ruby, Python, Go: the right tool, not the trendy one.' },
          { title: 'Open source', desc: 'Building tools so other developers can ship faster.' },
          { title: 'Writing it down', desc: 'Hard-earned lessons on architecture, debugging, and shipping.' },
          { title: 'Always exploring', desc: 'New languages, new patterns, new ways to think about problems.' },
        ].map((item, i) => (
          <div class={`flex gap-5 py-5 border-b border-border ${i < 3 ? '' : 'border-b-0'} reveal ${i > 0 ? `reveal-delay-${Math.min(i, 2)}` : ''}`}>
            <span class="font-mono text-accent/50 shrink-0 w-6 mt-0.5">&rarr;</span>
            <div>
              <h3 class="font-display text-base font-semibold mb-1 text-ink">{item.title}</h3>
              <p class="text-sm text-ink-dim leading-relaxed max-w-[45ch]">{item.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <FeaturedWork />

  <section class="page-section relative z-10 py-24 bg-surface-alt border-y border-border" id="writing">
    <div class="max-w-[42rem] mx-auto px-6">
      <h2 class="font-display text-[clamp(1.5rem,3vw,2.25rem)] font-semibold tracking-[-0.75px] leading-[1.2] mb-6 max-w-[28ch] reveal">Writing it down</h2>
      <div class="text-ink-dim leading-relaxed max-w-[60ch] text-sm reveal reveal-delay-1">
        <p>Hard-earned lessons on architecture, debugging, and shipping — on Substack, and occasionally here on the blog.</p>
      </div>
      <div class="flex gap-4 mt-8 flex-wrap reveal reveal-delay-2">
        <a href="https://patrick204nqh.substack.com" class="font-mono text-xs text-ink no-underline px-5 py-2 rounded-[100px] border border-border bg-surface transition-all duration-300 hover:border-accent hover:bg-accent/5">Substack</a>
        <a href="/blog" class="font-mono text-xs text-ink no-underline px-5 py-2 rounded-[100px] border border-border bg-surface transition-all duration-300 hover:border-accent hover:bg-accent/5">Blog</a>
      </div>
    </div>
  </section>

  <ContactSection />
</Layout>

<script>
  /* Scroll reveal */
  if (window.IntersectionObserver) {
    var observer = new IntersectionObserver(function(entries) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) { entry.target.classList.add('visible'); observer.unobserve(entry.target); }
      });
    }, { rootMargin: '0px 0px -80px 0px', threshold: 0.1 });
    document.querySelectorAll('.reveal').forEach(function(el) { observer.observe(el); });
  }
</script>